{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advisor-client-engagement-workspace",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "advisor-client-engagement-workspace",
      "database_id": "cfec74d7-7be7-497f-b17a-ffbc14580cc5"
    }
  ]
}
